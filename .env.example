# Hindsight Service Configuration
# URL of the Hindsight server (e.g. http://localhost:8888 for local Docker or https://api.hindsight.vectorize.io for cloud)
HINDSIGHT_API_URL=http://localhost:8888

# Optional API key for Hindsight Cloud authentication (leave blank if running self-hosted local Hindsight)
HINDSIGHT_API_KEY=

# Dedicated memory bank ID for BATCHWISE supplier sourcing experiences
HINDSIGHT_BANK_ID=batchwise_supplier_memory

# LLM API key used by Hindsight server or local analysis fallback (e.g., OpenAI API key)
LLM_API_KEY=

# PostgreSQL Database connection URL (for structured app data persistence when enabled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/batchwise
